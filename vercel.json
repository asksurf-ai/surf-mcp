{
  "version": 2,
  "builds": [
    {
      "src": "api/mcp.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "api/healthz.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/openai-apps-challenge.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/oauth-protected-resource.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/oauth-authorization-server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/healthz",
      "dest": "/api/healthz.ts"
    },
    {
      "src": "/api/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/api/healthz",
      "dest": "/api/healthz.ts"
    },
    {
      "src": "/.well-known/openai-apps-challenge",
      "dest": "/api/openai-apps-challenge.ts"
    },
    {
      "src": "/.well-known/oauth-protected-resource",
      "dest": "/api/oauth-protected-resource.ts"
    },
    {
      "src": "/.well-known/oauth-authorization-server",
      "dest": "/api/oauth-authorization-server.ts"
    }
  ]
}
