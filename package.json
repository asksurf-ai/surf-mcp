{
  "name": "@surf-ai/surf-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for Surf crypto data API",
  "bin": {
    "surf-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "start:http": "SURF_MCP_TRANSPORT=http bun run src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@types/bun": "latest",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/asksurf-ai/surf-mcp"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "crypto",
    "surf",
    "model-context-protocol"
  ]
}
