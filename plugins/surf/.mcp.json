{
  "mcpServers": {
    "surf": {
      "url": "https://mcp.asksurf.ai/mcp/chatgpt",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "authorizationUrl": "https://api.asksurf.ai/muninn/v2/oauth/authorize",
            "tokenUrl": "https://api.asksurf.ai/muninn/v2/oauth/token",
            "registrationUrl": "https://api.asksurf.ai/muninn/v2/oauth/register",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "data:read",
              "openid",
              "email"
            ]
          }
        }
      }
    }
  }
}
